# Reply generation: supply a key for the selected OpenAI-compatible provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Optional: only needed for hosted Jev. Keep this before DECISION_API_KEY.
JEV_API_KEY=

# Decision service: replace these defaults with a provider recipe from README.adoc.
# For hosted Jev, set DECISION_API_KEY=${JEV_API_KEY} and its URL and timeout.
DECISION_BASE_URL=http://127.0.0.1:8100
DECISION_API_PATH=/v1/systemone
DECISION_API_KEY=local-demo
DECISION_MODEL=jev-latest
DECISION_TIMEOUT=120000
DECISION_FAN_OUT_THRESHOLD=0.5
DECISION_MIN_PROBABILITY=0.55
